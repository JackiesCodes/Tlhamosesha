# PostgreSQL (optional — projects persist in the browser when unset)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/decon"

# Vision providers (optional — the on-device engine runs without them).
# Set any combination; results are merged with the local pipeline.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o"
GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-2.0-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_VISION_MODEL="claude-sonnet-5-5"

# Optional external computer-vision microservice (YOLO / SAM / OpenCV / rembg).
# See docs/vision-service.md for the expected contract.
VISION_SERVICE_URL=""
